{:dont-track-permissions:}[dont track permissions]
{:deleted-file-restore:}[deleted file restore]
{:change-commit-author:}[change commit author]
{:change-commit-date:}[change commit date]
{:merge-with-forked-upstream:}[merge with forked upstream]
{:clone-with-submodules:}[clone with submodules]
