#!/usr/bin/env python3
"""Dependency-free client for the local Progress Notifier macOS app."""
import argparse
import json
import math
import re
import sys
import uuid
import urllib.error
import urllib.parse
import urllib.request

BASE = "http://127.0.0.1:8766"
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def request(path, method="GET", value=None):
    body = None if value is None else json.dumps(value, allow_nan=False).encode()
    req = urllib.request.Request(BASE + path, data=body, method=method,
                                 headers={"Content-Type": "application/json"} if body else {})
    with OPENER.open(req, timeout=3) as response:
        return json.load(response)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", nargs="?", help="Stable, unique item name")
    parser.add_argument("progress", nargs="?", type=float, help="Progress from 0 to 100")
    parser.add_argument("eta_seconds", nargs="?", type=float, help="Estimated seconds remaining")
    parser.add_argument("--description", help="Progress note saved with this percentage (up to 2000 characters)")
    parser.add_argument("--project", help="Project name displayed above the task title (empty clears metadata)")
    parser.add_argument("--project-icon", metavar="JSON", help="T3 projectIcon object: emoji, lucide, or monogram")
    parser.add_argument("--t3-environment-id", help="T3 environment ID for Enter-to-open (requires --t3-thread-id)")
    parser.add_argument("--t3-thread-id", help="T3 thread ID for Enter-to-open (requires --t3-environment-id)")
    parser.add_argument("--run-id", help="Stable UUID for this agent run")
    parser.add_argument("--parent-run-id", help="Spawning agent's run UUID (requires --run-id and --child)")
    role = parser.add_mutually_exclusive_group()
    role.add_argument("--child", dest="is_child", action="store_const", const=True, default=None,
                      help="Mark this run as a child/delegate task")
    role.add_argument("--no-child", dest="is_child", action="store_const", const=False,
                      help="Clear a mistaken child/delegate marker")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--health", action="store_true")
    group.add_argument("--list", action="store_true")
    group.add_argument("--dismiss", metavar="NAME")
    parser.add_argument("--require-running", "--no-launch", dest="require_running", action="store_true",
                        help="Report an error if the app is stopped (default: silently skip)")
    args = parser.parse_args()
    mode = args.health or args.list or args.dismiss is not None
    if mode and any(value is not None for value in (args.name, args.progress, args.eta_seconds, args.project, args.project_icon, args.description,
                                                   args.t3_environment_id, args.t3_thread_id, args.is_child, args.run_id, args.parent_run_id)):
        parser.error("Do not combine an option command with update arguments")
    path, method, value = "/health", "GET", None
    if args.list:
        path = "/items"
    elif args.dismiss is not None:
        if not args.dismiss.strip():
            parser.error("Dismissed name must not be empty")
        path, method = "/items?" + urllib.parse.urlencode({"name": args.dismiss}), "DELETE"
    elif not args.health:
        if args.name is None or args.progress is None or args.eta_seconds is None:
            parser.error("Supply NAME PROGRESS ETA_SECONDS, or --health / --list / --dismiss NAME")
        if not args.name.strip() or len(args.name.strip()) > 160 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in args.name):
            parser.error("Name must contain 1–160 characters without control characters")
        if not math.isfinite(args.progress) or not 0 <= args.progress <= 100:
            parser.error("Progress must be between 0 and 100")
        if not math.isfinite(args.eta_seconds) or not 0 <= args.eta_seconds <= 31536000:
            parser.error("ETA must be seconds remaining, between 0 and 31536000")
        path, method = "/items", "POST"
        value = {"name": args.name, "progress": args.progress, "etaSeconds": args.eta_seconds}
        for flag, field in ((args.run_id, "runId"), (args.parent_run_id, "parentRunId")):
            if flag is not None:
                try:
                    if not re.fullmatch(r"[0-9A-Fa-f]{8}-(?:[0-9A-Fa-f]{4}-){3}[0-9A-Fa-f]{12}", flag):
                        raise ValueError()
                    value[field] = str(uuid.UUID(flag))
                except ValueError:
                    parser.error(f"{field} must be a hyphenated UUID")
        if args.parent_run_id is not None:
            if args.run_id is None or args.is_child is not True:
                parser.error("--parent-run-id requires --run-id and --child")
            if value["runId"] == value["parentRunId"]:
                parser.error("A run cannot be its own parent")
        if args.is_child is not None:
            value["isChild"] = args.is_child
        if args.t3_environment_id is not None or args.t3_thread_id is not None:
            if not all(identifier is not None and re.fullmatch(r"[A-Za-z0-9_:-]{1,512}", identifier)
                       for identifier in (args.t3_environment_id, args.t3_thread_id)):
                parser.error("Supply both T3 IDs, each containing 1–512 ASCII letters, digits, hyphens, underscores, or colons")
            value["t3Thread"] = {"environmentId": args.t3_environment_id, "threadId": args.t3_thread_id}
        if args.description is not None:
            description = args.description.replace("\r\n", "\n").replace("\r", "\n").strip()
            if len(description) > 2000 or any((ord(c) < 32 or 127 <= ord(c) <= 159) and c not in "\n\t" for c in description):
                parser.error("Description must contain at most 2000 characters, with only newline and tab control characters")
            value["description"] = description
        if args.project is not None:
            project = args.project.strip()
            if len(project) > 160 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in project):
                parser.error("Project must contain at most 160 characters without control characters")
            value["project"] = project
        if args.project_icon is not None:
            try:
                icon = json.loads(args.project_icon)
            except (ValueError, TypeError):
                parser.error("Project icon must be a JSON object")
            if not isinstance(icon, dict) or icon.get("kind") not in ("emoji", "lucide", "monogram"):
                parser.error("Project icon must be a T3 emoji, lucide, or monogram object")
            value["projectIcon"] = icon
    try:
        try:
            result = request(path, method, value)
        except urllib.error.HTTPError:
            raise
        except (urllib.error.URLError, TimeoutError, ConnectionError):
            if args.require_running:
                raise RuntimeError("Progress Notifier is not listening on 127.0.0.1:8766")
            return 0
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except urllib.error.HTTPError as error:
        print(f"Progress Notifier: HTTP {error.code}: {error.read().decode(errors='replace')}", file=sys.stderr)
    except (RuntimeError, OSError, ValueError, urllib.error.URLError) as error:
        print(f"Progress Notifier: {error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
