#!/usr/bin/env python3
"""Dependency-free client for the local Progress Notifier macOS app."""
import argparse
import json
import math
from pathlib import Path
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

BASE = "http://127.0.0.1:8766"
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def request(path, method="GET", value=None):
    body = None if value is None else json.dumps(value, allow_nan=False).encode()
    req = urllib.request.Request(BASE + path, data=body, method=method,
                                 headers={"Content-Type": "application/json"} if body else {})
    with OPENER.open(req, timeout=3) as response:
        return json.load(response)


def launch():
    if sys.platform != "darwin":
        raise RuntimeError("Progress Notifier runs on macOS; send requests on the Mac running it")
    candidates = [Path("/Applications/Progress Notifier.app"),
                  Path.home() / "Applications/Progress Notifier.app",
                  Path.home() / "Code/progress-notifier/build/Progress Notifier.app"]
    # Also work when invoked from a checkout in another location.
    candidates.append(Path(__file__).resolve().parents[3] / "build/Progress Notifier.app")
    app = next((path for path in candidates if path.is_dir()), None)
    if app is None:
        raise RuntimeError("Build the app first: cd ~/Code/progress-notifier && ./scripts/build.sh")
    subprocess.run(["open", "-g", str(app)], check=True, capture_output=True)
    for _ in range(30):
        try:
            health = request("/health")
            if health.get("app") != "progress-notifier":
                raise RuntimeError("Port 8766 is occupied by another service")
            return
        except urllib.error.URLError:
            time.sleep(0.1)
    raise RuntimeError("The app did not start listening on port 8766")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", nargs="?", help="Stable, unique item name")
    parser.add_argument("progress", nargs="?", type=float, help="Progress from 0 to 100")
    parser.add_argument("eta_seconds", nargs="?", type=float, help="Estimated seconds remaining")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--health", action="store_true")
    group.add_argument("--list", action="store_true")
    group.add_argument("--dismiss", metavar="NAME")
    parser.add_argument("--no-launch", action="store_true", help="Fail if the app is not running")
    args = parser.parse_args()
    mode = args.health or args.list or args.dismiss is not None
    if mode and any(value is not None for value in (args.name, args.progress, args.eta_seconds)):
        parser.error("Do not combine an option command with update arguments")
    path, method, value = "/health", "GET", None
    if args.list:
        path = "/items"
    elif args.dismiss is not None:
        if not args.dismiss.strip():
            parser.error("Dismissed name must not be empty")
        path, method = "/items?" + urllib.parse.urlencode({"name": args.dismiss}), "DELETE"
    elif not args.health:
        if args.name is None or args.progress is None or args.eta_seconds is None:
            parser.error("Supply NAME PROGRESS ETA_SECONDS, or --health / --list / --dismiss NAME")
        if not args.name.strip() or len(args.name.strip()) > 160 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in args.name):
            parser.error("Name must contain 1–160 characters without control characters")
        if not math.isfinite(args.progress) or not 0 <= args.progress <= 100:
            parser.error("Progress must be between 0 and 100")
        if not math.isfinite(args.eta_seconds) or not 0 <= args.eta_seconds <= 31536000:
            parser.error("ETA must be seconds remaining, between 0 and 31536000")
        path, method = "/items", "POST"
        value = {"name": args.name, "progress": args.progress, "etaSeconds": args.eta_seconds}
    try:
        try:
            result = request(path, method, value)
        except urllib.error.HTTPError:
            raise
        except urllib.error.URLError:
            if args.no_launch:
                raise RuntimeError("Progress Notifier is not listening on 127.0.0.1:8766")
            launch()
            result = request(path, method, value)
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except urllib.error.HTTPError as error:
        print(f"Progress Notifier: HTTP {error.code}: {error.read().decode(errors='replace')}", file=sys.stderr)
    except (RuntimeError, OSError, ValueError, urllib.error.URLError, subprocess.CalledProcessError) as error:
        print(f"Progress Notifier: {error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
