{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "variant.cycle": "none",
    "variant.list": "ctrl+t",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.first": "ctrl+g,home",
    "session.last": "ctrl+shift+g,end",
    "session.message.next": "ctrl+f",
    "session.message.previous": "ctrl+b"
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "split"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true
}
